@model InspectionTracker.Domain.FollowUp

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>FollowUp</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Inspection)
        </dt>
        <dd class="col-sm-10">
            @(Model.Inspection.Premises?.Name ?? "[No premises]") –
            @Model.Inspection.InspectionDate.ToString("dd/MM/yyyy")
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DueDate)
        </dt>
        <dd class="col-sm-10">
            @Model.DueDate.ToString("dd/MM/yyyy")
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ClosedDate)
        </dt>
        <dd class="col-sm-10">
            @(Model.ClosedDate?.ToString("dd/MM/yyyy") ?? "-")
        </dd>
    </dl>
</div>

<div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a>
        <span> | </span>
    }
    <a asp-action="Index">Back to List</a>
</div>
