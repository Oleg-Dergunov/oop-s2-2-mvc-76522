@model IEnumerable<InspectionTracker.Domain.FollowUp>

@{
    ViewData["Title"] = "FollowUps";
}

<h1>FollowUps</h1>

<p>
    @if (User.IsInRole("Admin") || User.IsInRole("Inspector"))
    {
        <a asp-action="Create">Create New</a>
    }
</p>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Inspection)</th>
            <th>@Html.DisplayNameFor(model => model.DueDate)</th>
            <th>@Html.DisplayNameFor(model => model.Status)</th>
            <th>@Html.DisplayNameFor(model => model.ClosedDate)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @(item.Inspection.Premises?.Name ?? "[No premises]") –
                    @item.Inspection.InspectionDate.ToString("dd/MM/yyyy")
                </td>

                <td>@item.DueDate.ToString("dd/MM/yyyy")</td>

                <td>@Html.DisplayFor(modelItem => item.Status)</td>

                <td>
                    @(item.ClosedDate?.ToString("dd/MM/yyyy") ?? "-")
                </td>

                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a>

                    @if (User.IsInRole("Inspector") && item.ClosedDate == null)
                    {
                        <span> | </span>
                        <a asp-action="Close" asp-route-id="@item.Id">Close</a>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <span> | </span>
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                        <span> | </span>
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
